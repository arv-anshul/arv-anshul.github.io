{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/biome/core", "ultracite/biome/astro"],
  "overrides": [
    {
      // YAML is formatted by dprint (see .pre-commit-config.yaml).
      "includes": ["**/*.yaml", "**/*.yml"],
      "formatter": {
        "enabled": false
      }
    },
    {
      "includes": [
        "src/components/starwind/**/*",
        "src/components/ui/search.astro"
      ],
      "linter": {
        "enabled": false
      },
      "formatter": {
        "enabled": false
      }
    },
    {
      "includes": [
        "src/pages/blog/index.astro",
        "src/pages/resume/index.astro"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noUndeclaredVariables": "off"
          }
        }
      }
    }
  ]
}
