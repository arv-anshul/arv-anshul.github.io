---
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import "@/styles/global.css";
import type { HTMLAttributes } from "astro/types";
import { SEO, type SEOProps } from "astro-seo";
import JsonLd from "@/components/seo/json-ld.astro";
import Footer from "@/components/ui/footer.astro";
import Navbar from "@/components/ui/navbar.astro";
import {
  DEFAULT_DESCRIPTION,
  LOCALE,
  SITE_KEYWORDS,
  THEME_COLOR_DARK,
  THEME_COLOR_LIGHT,
  TWITTER_HANDLE,
} from "@/consts";
import { getSocialUrl, loadInfoData } from "@/lib/data-loaders/info";
import { getBreadcrumbJsonLd } from "@/lib/seo";
import { cn } from "@/lib/utils";
import themeInit from "@/scripts/theme-init.js?raw";

interface Props extends HTMLAttributes<"body"> {
  description?: string;
  jsonLd?: Record<string, unknown> | (Record<string, unknown> | null)[];
  keywords?: string[];
  nav?: {
    sticky?: boolean;
  };
  seo?: SEOProps["openGraph"];
  title: string;
}

const {
  title = "ARV - Website",
  description = DEFAULT_DESCRIPTION,
  jsonLd,
  keywords,
  nav = {
    sticky: false,
  },
  class: className,
  seo,
  ...props
} = Astro.props as Props;

const info = await loadInfoData();
const authorLinkedIn = getSocialUrl(info, "LinkedIn");
const metaKeywords = (keywords ?? SITE_KEYWORDS).join(", ");
const breadcrumb = getBreadcrumbJsonLd(Astro.url, info.site_url);
const jsonLdItems = [breadcrumb, jsonLd].flat().filter(Boolean);
---

<html lang="en">
  <head>
    <meta charset="utf-8">
    <link href="/favicon.svg" rel="icon" type="image/svg+xml">
    <meta content="width=device-width" name="viewport">
    <ClientRouter />
    <meta content={Astro.generator} name="generator">
    <Font cssVariable="--font-inter" />
    <Font cssVariable="--font-geist-mono" />
    <SEO
      description={description}
      extend={{
        link: [
          { rel: "author", href: authorLinkedIn },
          { rel: "icon", href: "/favicon.ico", sizes: "any" },
          { rel: "apple-touch-icon", href: "/apple-touch-icon.png" },
          { rel: "manifest", href: "/site.webmanifest" },
        ],
        meta: [
          { name: "author", content: info.name },
          { name: "keywords", content: metaKeywords },
          {
            name: "theme-color",
            media: "(prefers-color-scheme: light)",
            content: THEME_COLOR_LIGHT,
          },
          {
            name: "theme-color",
            media: "(prefers-color-scheme: dark)",
            content: THEME_COLOR_DARK,
          },
        ],
      }}
      openGraph={{
        basic: {
          title,
          type: "website",
          image: new URL("og.webp", Astro.url).toString(),
          url: Astro.url,
        },
        optional: {
          description,
          siteName: info.name,
          locale: LOCALE,
        },
        ...seo,
      }}
      title={title}
      twitter={{
        card: "summary_large_image",
        site: TWITTER_HANDLE,
        creator: TWITTER_HANDLE,
        title,
        description,
      }}
    />
    <JsonLd data={jsonLdItems} />
    <link href="/sitemap-index.xml" rel="sitemap">
    <link
      href={new URL("rss.xml", Astro.site)}
      rel="alternate"
      title="ARV's Blog RSS"
      type="application/rss+xml"
    >
    <script is:inline set:html={themeInit} />
  </head>
  <body
    class="relative w-full min-h-screen flex flex-col selection:bg-muted-foreground selection:text-accent"
    {...props}
  >
    <Navbar sticky={nav.sticky} />
    <main
      class={cn(
        "mx-auto w-full flex-1 px-4 py-8 md:w-2/3 md:px-0 xl:w-3/5",
        className,
      )}
    >
      <slot />
    </main>
    <Footer />
  </body>
</html>
