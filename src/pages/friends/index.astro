---
import FriendCard from "@/components/friend-card.astro";
import BaseLayout from "@/layouts/base-layout.astro";
import { loadFriendsData } from "@/lib/data-loaders/friends";

const { friends } = await loadFriendsData();
---

<BaseLayout
  description="Meet the friends and fellow developers Anshul Raj Verma builds, learns and shares this journey with, in tech and beyond."
  nav={{ sticky: true }}
  title="Friends — People I Build & Learn Alongside"
>
  <header class="text-center">
    <h1 class="font-bold text-3xl font-heading">Friends</h1>
    <p class="text-xl text-muted-foreground">
      Meet the awesome people and projects I follow.
    </p>
  </header>

  <section class="mt-8 w-full grid grid-cols-1 sm:grid-cols-2 gap-4">
    {friends.map((friend) => <FriendCard friend={friend} />)}
  </section>
</BaseLayout>
