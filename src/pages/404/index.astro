---
import BaseLayout from "@/layouts/base-layout.astro";
---

<BaseLayout
  description="The page you're looking for may have been moved, renamed or removed. Head back home to explore projects, blog and more."
  seo={{
    basic: {
      title: "404 — Page Not Found",
      type: "website",
      image: new URL("/404/og.webp", Astro.url).toString(),
      url: Astro.url,
    },
  }}
  title="404 — Page Not Found"
>
  <div
    class="flex flex-col h-[60vh] flex-1 items-center justify-center text-center"
  >
    <div class="flex flex-col items-center gap-4 font-mono">
      <h1 class="text-6xl font-bold text-muted-foreground">404</h1>
      <h2 class="text-2xl font-semibold">Page Not Found</h2>
      <p class="text-muted-foreground max-w-md">
        The page you are looking for might have been removed, had its name
        changed, or is temporarily unavailable.
      </p>
      <a
        class="mt-4 px-4 py-2 rounded-md bg-accent font-medium text-sm hover:opacity-80 transition-opacity"
        href="/"
      >
        Back to Home
      </a>
    </div>
  </div>
</BaseLayout>
