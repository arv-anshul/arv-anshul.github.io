---
import { joinPaths } from "@astrojs/internal-helpers/path";
import Button from "@/components/starwind/button";
import BaseLayout from "@/layouts/base-layout.astro";

const resumeUrl = joinPaths(Astro.url.toString(), "basic.pdf");

if (Astro.url.searchParams.get("download")) {
  Astro.redirect(resumeUrl);
}
---

<BaseLayout
  description="Resume of Anshul Raj Verma, Data Scientist specializing in GenAI, LangChain and Python. View online or download the PDF."
  title="Resume — Anshul Raj Verma, Data Scientist & GenAI Dev"
>
  <a
    class="mx-auto mb-5 block w-fit bg-foreground px-8 py-2 text-sm font-semibold text-background transition-opacity hover:opacity-90"
    href="/resume/download"
  >
    Download Resume
  </a>
  <div class="p-3 w-5/6 bg-muted/50 mx-auto">
    <iframe
      class="h-200 w-full"
      src={`https://docs.google.com/viewerng/viewer?url=${resumeUrl}&embedded=true`}
      title="Anshul Raj Verma - Resume"
    ></iframe>
  </div>
</BaseLayout>
