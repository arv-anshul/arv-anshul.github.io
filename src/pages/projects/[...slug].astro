---
import {
  type CollectionEntry,
  getCollection,
  type InferEntrySchema,
  render,
} from "astro:content";
import type { GetStaticPaths } from "astro";
import FrontmatterCard from "@/components/frontmatter-card.astro";
import NestedPagesList from "@/components/nested-pages-list.astro";
import Prose from "@/components/starwind/prose";
import BaseLayout from "@/layouts/base-layout.astro";
import { loadInfoData } from "@/lib/data-loaders/info";
import { getArticleJsonLd } from "@/lib/seo";
import "remark-github-alerts/styles/github-base.css";
import "remark-github-alerts/styles/github-colors-light.css";
import "remark-github-alerts/styles/github-colors-dark-class.css";
import "@/styles/custom-prose.css";

interface Props {
  nestedPages?: {
    id: string;
    data: InferEntrySchema<"projects">;
  }[];
  project: CollectionEntry<"projects">;
}

export const getStaticPaths = (async () => {
  const projects = await getCollection("projects");

  return projects.map((p) => {
    const children = projects.filter((i) =>
      i.id.startsWith(i.id.split("/")[0])
    );

    return {
      params: { slug: p.id },
      props: {
        nestedPages: children.length > 1 ? children : undefined, // Only contains the sub-pages for a specific project
        project: p,
      },
    };
  });
}) satisfies GetStaticPaths;

const { project, nestedPages } = Astro.props as Props;
const { Content } = await render(project);

const info = await loadInfoData();
const ogImage = new URL("og.webp", Astro.url).toString();
---

<BaseLayout
  class="md:max-w-3/5"
  description={project.data.description}
  jsonLd={getArticleJsonLd({
    author: project.data.author,
    categories: project.data.categories,
    description: project.data.description,
    image: ogImage,
    pubDate: project.data.pubDate,
    siteUrl: info.site_url,
    title: project.data.title,
    updatedDate: project.data.updatedDate,
    url: Astro.url.toString(),
  })}
  keywords={project.data.categories}
  seo={{
    article: {
      authors: [project.data.author],
      modifiedTime: (project.data.updatedDate ?? project.data.pubDate).toISOString(),
      publishedTime: project.data.pubDate.toISOString(),
      section: project.data.categories[0],
      tags: project.data.categories,
    },
    basic: {
      image: ogImage,
      title: project.data.title,
      type: "article",
      url: Astro.url,
    },
  }}
  title={`${project.data.title} - ARV Project`}
>
  <FrontmatterCard backPageUrl="/projects" data={project.data} />
  {nestedPages && (
      <section class="my-6">
        <NestedPagesList pages={nestedPages} />
      </section>
    )}

  <article class="mt-10 w-full" data-pagefind-body>
    <Prose class="max-w-auto w-full custom-prose"> <Content /> </Prose>
  </article>
</BaseLayout>
