---
import { Icon } from "astro-icon/components";
import {
  Item,
  ItemContent,
  ItemDescription,
  ItemGroup,
  ItemMedia,
  ItemTitle,
} from "@/components/starwind/item";
import BaseLayout from "@/layouts/base-layout.astro";
import { loadAllProjects } from "@/lib/data-loaders/all-projects";

const { projects } = await loadAllProjects();
---

<BaseLayout
  description="A full list of Anshul Raj Verma's minor projects and experiments — small tools, prototypes and side builds in Python and AI."
  nav={{ sticky: true }}
  title="All Projects — Minor Builds & Experiments by ARV"
>
  <div>
    <h1 class="font-heading mb-6 text-3xl font-bold md:text-center">
      All Projects Index
    </h1>
    <ItemGroup class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2">
      {projects.map((project) => (
        <Item
          as="a"
          class="py-3"
          href={project.url}
          target="_blank"
          variant="outline"
        >
          <ItemMedia class="h-full">
            <Icon name={project.icon} size={35} />
          </ItemMedia>
          <ItemContent class="gap-1">
            <ItemTitle class="text-base font-bold">{project.title}</ItemTitle>
            <ItemDescription class="line-clamp-2 text-wrap">
              {project.description}
            </ItemDescription>
          </ItemContent>
        </Item>
      ))}
    </ItemGroup>
  </div>
</BaseLayout>
