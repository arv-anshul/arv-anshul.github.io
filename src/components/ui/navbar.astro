---
// Component from https://tailkits.com/ui/free/
import { Icon } from "astro-icon/components";
import OmSvg from "public/favicon.svg";
import { ThemeToggle } from "@/components/starwind/theme-toggle";
import { cn } from "@/lib/utils";
import Button from "../starwind/button";
import Search from "./search.astro";

interface Props {
  sticky?: boolean;
}

const { sticky = false } = Astro.props;

const homeLink = {
  alt: "Om Logo",
  href: "/",
  title: "ARV",
};

const middleLinks = [
  { href: "/projects", icon: "lucide:rocket", title: "Projects" },
  { href: "/blog", icon: "lucide:newspaper", title: "Blog" },
  { href: "/journal", icon: "lucide:notebook-pen", title: "Journal" },
  { href: "/resume", icon: "lucide:scroll-text", title: "Resume" },
];

const endLinks = [
  {
    href: "/github",
    icon: "simple-icons:github",
    title: "GitHub",
  },
];
---

<header
  class={cn(
    "border-b-muted/50 border-b backdrop-blur-sm",
    sticky ? "sticky top-0 z-40" : ""
  )}
>
  <div
    class="mx-auto flex items-center justify-between gap-x-2 px-4 py-1 md:w-2/3 md:px-0 xl:w-3/5"
  >
    <!-- Home/Logo -->
    <div class="flex items-center">
      <a class="flex items-center" href={homeLink.href} title={homeLink.title}>
        <OmSvg
          class="fill-foreground stroke-foreground"
          height="30"
          width="30"
        />
      </a>
    </div>

    <!-- Desktop Navigation -->
    <nav class="mr-auto ml-2">
      <ul class="flex items-center">
        {middleLinks.map((link) => (
          <li>
            <Button
              class="flex items-center gap-x-1 rounded-xl"
              href={link.href}
              size="sm"
              variant="ghost"
            >
              <Icon class="hidden md:inline" name={link.icon} />
              {link.title}
            </Button>
          </li>
        ))}
      </ul>
    </nav>

    <!-- End Links (Desktop Icons) -->
    <div class="flex items-center gap-x-2 justify-self-end">
      <!-- Search trigger + dialog -->
      <Search />

      <div class="flex items-center gap-x-1">
        {endLinks.map((link) => (
          <Button
            class="hover:bg-transparent hover:opacity-70"
            href={link.href}
            size="icon"
            target="_blank"
            title={link.title}
            variant="ghost"
          >
            <Icon name={link.icon} />
          </Button>
        ))}

        <ThemeToggle size="sm" />
      </div>
    </div>
  </div>
</header>
