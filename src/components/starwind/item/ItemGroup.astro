---
import type { HTMLAttributes } from "astro/types";

import { itemGroup } from "./variants";

type Props = HTMLAttributes<"div">;

const { class: className, ...rest } = Astro.props;
---

<div
  class={itemGroup({ class: className })}
  role="list"
  {...rest}
  data-slot="item-group"
>
  <slot />
</div>
